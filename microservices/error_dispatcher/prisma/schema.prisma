// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ErrorLog document schema for your AI Agent pipeline
model error_log {
  id          Int      @id @default(autoincrement())
  service     String
  message     String
  path        String
  method      String
  statusCode  Int
  isProcessed Boolean  @default(false)
  aiAnalysis  String?
  createdAt   DateTime @default(now())

  // Prevents identical unprocessed logs for the same resource
  @@unique([service, message, isProcessed], name: "unique_unprocessed_error")
}